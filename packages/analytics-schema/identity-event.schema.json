{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Identity event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "user_id", "type", "version", "payload", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "enum": [
        "registration.completed",
        "identity.verified",
        "identity.logout",
        "profile.updated",
        "consent.changed",
        "data_request.created",
        "data_request.review_started",
        "data_export.completed",
        "legal_hold.created",
        "legal_hold.released"
      ]
    },
    "version": {
      "const": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id"],
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
