{
  "components": {
    "schemas": {
      "ConsentInput": {
        "additionalProperties": false,
        "properties": {
          "affirmative": {
            "const": true,
            "title": "Affirmative",
            "type": "boolean"
          },
          "challenge_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Challenge Id"
          },
          "code": {
            "anyOf": [
              {
                "pattern": "^[0-9]{6}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "consent_type": {
            "enum": [
              "SELF",
              "ASSENT",
              "GUARDIAN",
              "WITHDRAW"
            ],
            "title": "Consent Type",
            "type": "string"
          },
          "guardian_name": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Guardian Name"
          },
          "guardian_relationship": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Guardian Relationship"
          },
          "policy_version": {
            "maxLength": 80,
            "title": "Policy Version",
            "type": "string"
          }
        },
        "required": [
          "consent_type",
          "policy_version",
          "affirmative"
        ],
        "title": "ConsentInput",
        "type": "object"
      },
      "Credentials": {
        "additionalProperties": false,
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "const": 900,
            "default": 900,
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "const": "Bearer",
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token"
        ],
        "title": "Credentials",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "api": {
            "const": "up",
            "default": "up",
            "title": "Api",
            "type": "string"
          },
          "database": {
            "enum": [
              "up",
              "down"
            ],
            "title": "Database",
            "type": "string"
          },
          "redis": {
            "enum": [
              "up",
              "down"
            ],
            "title": "Redis",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database",
          "redis"
        ],
        "title": "Health",
        "type": "object"
      },
      "Live": {
        "properties": {
          "status": {
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Live",
        "type": "object"
      },
      "OTPAccepted": {
        "additionalProperties": false,
        "properties": {
          "challenge_id": {
            "format": "uuid",
            "title": "Challenge Id",
            "type": "string"
          },
          "message": {
            "default": "If eligible, a verification code will be delivered.",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "challenge_id"
        ],
        "title": "OTPAccepted",
        "type": "object"
      },
      "OTPRequest": {
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "identifier": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Identifier",
            "type": "string"
          },
          "purpose": {
            "default": "LOGIN",
            "enum": [
              "LOGIN",
              "LINK",
              "GUARDIAN"
            ],
            "title": "Purpose",
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "device_id"
        ],
        "title": "OTPRequest",
        "type": "object"
      },
      "OTPVerify": {
        "additionalProperties": false,
        "properties": {
          "challenge_id": {
            "format": "uuid",
            "title": "Challenge Id",
            "type": "string"
          },
          "code": {
            "pattern": "^[0-9]{6}$",
            "title": "Code",
            "type": "string"
          },
          "purpose": {
            "default": "LOGIN",
            "enum": [
              "LOGIN",
              "LINK"
            ],
            "title": "Purpose",
            "type": "string"
          }
        },
        "required": [
          "challenge_id",
          "code"
        ],
        "title": "OTPVerify",
        "type": "object"
      },
      "ProfilePatch": {
        "additionalProperties": false,
        "properties": {
          "birth_date": {
            "format": "date",
            "title": "Birth Date",
            "type": "string"
          },
          "display_name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "subject_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 2,
            "minItems": 1,
            "title": "Subject Ids",
            "type": "array"
          }
        },
        "required": [
          "display_name",
          "birth_date",
          "subject_ids"
        ],
        "title": "ProfilePatch",
        "type": "object"
      },
      "ProfileView": {
        "additionalProperties": false,
        "properties": {
          "birth_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Birth Date"
          },
          "consent_required": {
            "items": {
              "type": "string"
            },
            "title": "Consent Required",
            "type": "array"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "identifier_count": {
            "title": "Identifier Count",
            "type": "integer"
          },
          "learning_allowed": {
            "title": "Learning Allowed",
            "type": "boolean"
          },
          "level": {
            "const": "Senior 4",
            "default": "Senior 4",
            "title": "Level",
            "type": "string"
          },
          "policy_version": {
            "title": "Policy Version",
            "type": "string"
          },
          "subject_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Subject Ids",
            "type": "array"
          }
        },
        "required": [
          "id",
          "display_name",
          "birth_date",
          "subject_ids",
          "consent_required",
          "learning_allowed",
          "policy_version",
          "identifier_count"
        ],
        "title": "ProfileView",
        "type": "object"
      },
      "Refresh": {
        "additionalProperties": false,
        "properties": {
          "refresh_token": {
            "maxLength": 128,
            "minLength": 32,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "Refresh",
        "type": "object"
      },
      "SubjectView": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "SubjectView",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Kasoma API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout"
      }
    },
    "/api/v1/auth/logout-all": {
      "post": {
        "operationId": "logout_all_api_v1_auth_logout_all_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout All"
      }
    },
    "/api/v1/auth/otp/request": {
      "post": {
        "operationId": "request_otp_api_v1_auth_otp_request_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OTPRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OTPAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Request Otp"
      }
    },
    "/api/v1/auth/otp/verify": {
      "post": {
        "operationId": "verify_api_v1_auth_otp_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OTPVerify"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Credentials"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Verify"
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "refresh_api_v1_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Refresh"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Credentials"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Refresh"
      }
    },
    "/api/v1/curriculum/subjects": {
      "get": {
        "operationId": "subjects_api_v1_curriculum_subjects_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SubjectView"
                  },
                  "title": "Response Subjects Api V1 Curriculum Subjects Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Subjects"
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Dependency unavailable"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v1/live": {
      "get": {
        "operationId": "get_liveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Live"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live"
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "me_api_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me"
      },
      "patch": {
        "operationId": "patch_me_api_v1_me_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfilePatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Patch Me"
      }
    },
    "/api/v1/me/consents": {
      "post": {
        "operationId": "consent_api_v1_me_consents_post",
        "parameters": [
          {
            "in": "header",
            "name": "idempotency-key",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Consent"
      }
    }
  }
}
