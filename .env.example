# Configuration vocabulary for E0 bootstrap; no application consumes this yet.
# Copy to .env when implementing the runtime. Never put real secrets here.
# Empty secret fields intentionally have no defaults.
APP_ENV=development
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_CONTAINER=kasoma-local
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
JWT_SIGNING_KEY=
TOKEN_ISSUER=kasoma-local
OTP_PROVIDER=fake
OTP_EMAIL_PROVIDER=fake
OTP_SMS_PROVIDER=fake
OTP_SMS_MONTHLY_BUDGET=0
OTP_EMAIL_FROM=
OTP_SMS_SENDER=
EMAIL_PROVIDER=mailpit
SMS_PROVIDER=fake
WHATSAPP_PROVIDER=fake
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
AI_PROVIDER=fake
AI_ENDPOINT=
AI_API_KEY=
AI_GRADING_MODEL=
AI_EMBEDDING_MODEL=
MODEL_PROVIDER=fake
MODEL_API_STYLE=openai_compatible
# Host processes use localhost; containers use host.docker.internal.
MODEL_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_ALIAS=local-quality
ALLOW_EXTERNAL_API_CALLS=false
ALLOW_GOOGLE_FREE_TIER_EVAL=false
GEMINI_EVAL_MODEL=
GEMINI_API_KEY=
GEMINI_EVAL_MAX_REQUESTS=100
# An explicit token ceiling is required before any manual evaluation.
GEMINI_EVAL_MAX_INPUT_TOKENS=
# Production provider and regions require the Week 8 decision.
CLOUD_PROVIDER=
CLOUD_PRIMARY_REGION=
CLOUD_RECOVERY_REGION=
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_REPORTING_DSN=
