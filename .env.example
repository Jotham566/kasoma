# Local foundation configuration; make setup creates ignored .env.
# Never put real secrets here.
# Empty secret fields intentionally have no defaults.
APP_ENV=development
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_CONTAINER=kasoma-local
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
JWT_SIGNING_KEY=
TOKEN_ISSUER=kasoma-local
OTP_PROVIDER=fake
OTP_EMAIL_PROVIDER=fake
OTP_SMS_PROVIDER=fake
OTP_SMS_MONTHLY_BUDGET=0
OTP_EMAIL_FROM=
OTP_SMS_SENDER=
EMAIL_PROVIDER=mailpit
SMS_PROVIDER=fake
WHATSAPP_PROVIDER=fake
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=synthetic-phone
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ID=synthetic-business
WHATSAPP_OUTBOUND_ENABLED=false
WHATSAPP_OUTBOUND_PER_MINUTE=10
WHATSAPP_LINK_ATTEMPTS_PER_MINUTE=5
AI_PROVIDER=fake
AI_ENDPOINT=
AI_API_KEY=
AI_GRADING_MODEL=
AI_EMBEDDING_MODEL=
MODEL_PROVIDER=fake
# Candidate short-text flow remains disabled until its full acceptance and academic gates pass.
SHORT_TEXT_ENABLED=false
SHORT_TEXT_MAX_REQUESTS=3
SHORT_TEXT_MAX_TOKENS=16384
SHORT_TEXT_TIMEOUT_MS=5000
SHORT_TEXT_MODEL_VERSION=fixture-v1
SHORT_TEXT_PROMPT_VERSION=synthetic-short-text-dual-pass-v2
SHORT_TEXT_CONFIGURATION_VERSION=short-text-runtime-v1
MODEL_API_STYLE=openai_compatible
# Host processes use localhost; containers use host.docker.internal.
MODEL_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_ALIAS=local-quality
ALLOW_EXTERNAL_API_CALLS=false
ALLOW_GOOGLE_FREE_TIER_EVAL=false
GEMINI_EVAL_MODEL=
GEMINI_API_KEY=
GEMINI_EVAL_MAX_REQUESTS=100
# An explicit token ceiling is required before any manual evaluation.
GEMINI_EVAL_MAX_INPUT_TOKENS=
# Production provider and regions require the Week 8 decision.
CLOUD_PROVIDER=
CLOUD_PRIMARY_REGION=
CLOUD_RECOVERY_REGION=
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_REPORTING_DSN=
# Local Compose bootstrap (make setup generates these in ignored .env).
POSTGRES_PASSWORD=
MAILPIT_HOST=localhost
MAILPIT_PORT=1025

# Separate local identity keys; make setup generates these without printing them.
IDENTITY_ENCRYPTION_KEY=
IDENTITY_LOOKUP_KEY=
CONSENT_POLICY_VERSION=synthetic-development-v1

# Local synthetic assessment windows; these are not retention periods.
ASSESSMENT_SESSION_DAYS=7
ASSESSMENT_REPETITION_DAYS=7

# Local operational alert defaults; server-side only, no external delivery.
OPS_FAILED_IMPORT_THRESHOLD=1
OPS_REQUEST_P95_MS=500
OPS_REQUEST_MIN_SAMPLES=20
OPS_IMPORT_AGE_SECONDS=300
OPS_FLAG_BACKLOG_THRESHOLD=20
# Process-role flag: Compose enables observation only on the ordinary worker.
MODEL_OBSERVATION_ENABLED=false
OPS_MODEL_GATEWAY_ATTEMPTS_THRESHOLD=100
OPS_GRADING_AGE_SECONDS=60
OPS_EXPORT_FAILURE_THRESHOLD=1
OPS_EXPORT_AGE_SECONDS=300
OPS_CHANNEL_FAILURE_THRESHOLD=1
OPS_CHANNEL_QUEUE_AGE_SECONDS=60
OPS_CHANNEL_DISPATCH_P95_MS=1500
OPS_CHANNEL_DISPATCH_MIN_SAMPLES=20

# Enable only after all API/worker readers support terminal receipt holds.
CHANNEL_RECEIPT_HOLDS_ENABLED=false

# ADR-057 bounded synthetic capture only; keep false until full reader/lifecycle verification.
CHANNEL_PRESERVATION_ENABLED=false

# ADR-060 exact synthetic export evidence holds; review-stack retirement stays disabled.
EXPORT_EVIDENCE_HOLDS_ENABLED=false

# ADR-060: publish only to a separate private executor, and only in isolated synthetic scopes.
EXPORT_RETIREMENT_ENABLED=false
EXPORT_RETIREMENT_INTERVAL_SECONDS=300
# Never put the executor database URL here. Provision .local/export-retirement.env (0600).

# ADR-063: local API adapter outcomes only; no delivery/billing claims.
OTP_OBSERVATION_ENABLED=false
OPS_OTP_FAILURES_THRESHOLD=1
